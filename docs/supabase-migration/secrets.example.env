# ============================================
# FRONTEND (Vercel env vars — safe to expose)
# ============================================
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...  # anon key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# ============================================
# EDGE FUNCTION SECRETS (set via `supabase secrets set` or Dashboard)
# DO NOT put these in Vercel — they only belong in Supabase
# ============================================

# Cloudinary (file storage CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Discord webhooks (one per content type)
DISCORD_WEBHOOK_TEXT=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_IMAGES=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_FILES=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_LINKS=https://discord.com/api/webhooks/...

# Shared secrets for protecting internal endpoints
# Generate with: openssl rand -hex 32
DISCORD_LOGGER_SECRET=
KEEP_ALIVE_SECRET=

# Optional: email alerts via Resend
RESEND_API_KEY=re_...
ALERT_EMAIL=you@example.com

# ============================================
# AUTO-INJECTED by Supabase — do NOT set these manually
# ============================================
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_DB_URL
