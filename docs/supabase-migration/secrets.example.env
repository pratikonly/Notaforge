# ============================================
# FRONTEND (Vercel env vars — safe to expose)
# ============================================
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...  # anon key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# ============================================
# EDGE FUNCTION SECRETS (set via `supabase secrets set` or Dashboard)
# DO NOT put these in Vercel — they only belong in Supabase
# ============================================


KEEP_ALIVE_SECRET=

# Optional: email alerts via Resend
RESEND_API_KEY=re_...
ALERT_EMAIL=you@example.com

# ============================================
# AUTO-INJECTED by Supabase — do NOT set these manually
# ============================================
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_DB_URL
