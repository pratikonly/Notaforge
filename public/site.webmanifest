{
  "name": "NotaForge",
  "short_name": "NotaForge",
  "description": "Simple notes vault to store, share, and organize text, images, PDFs, audio, video, and links.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#050505",
  "theme_color": "#050505",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
